{
    "name": "scal-e/cdp",
    "description": "Customer Data Platform (CDP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "seed": "php database/seed.php",
        "benchmark": "php database/benchmark.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
